# ─────────────────────────────────────────────────────────────
#  BUREAU DU PASTEUR — configuration
#  Copiez ce fichier en .env et adaptez les valeurs.
# ─────────────────────────────────────────────────────────────

# Général
APP_NAME="Bureau du Pasteur"
APP_ENV=development                 # development | production
SECRET_KEY=changez-moi-avec-une-longue-chaine-aleatoire
TIMEZONE=Europe/Paris
BASE_URL=http://localhost:8000       # utilisé dans les liens de validation mobile

# Base de données (SQLite par défaut, PostgreSQL en production)
DATABASE_URL=sqlite:///./data/bureau.db
# DATABASE_URL=postgresql+psycopg://bureau:bureau@db:5432/bureau

# Compte administrateur initial (créé au premier démarrage s'il n'existe pas)
ADMIN_EMAIL=pasteur@exemple.org
ADMIN_PASSWORD=changez-moi
ADMIN_NAME="Pasteur"
PASTOR_PHONE=+33600000000            # reçoit les notifications de validation

# Intelligence artificielle
LLM_PROVIDER=template                # template (hors-ligne) | anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# Canaux d'envoi (chaque canal reste en mode "console" tant qu'il n'est pas configuré)
SMS_PROVIDER=console                 # console | twilio
WHATSAPP_PROVIDER=console            # console | twilio
EMAIL_PROVIDER=console               # console | smtp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=bureau@exemple.org

# Règles de validation
DOUBLE_CONFIRMATION_THRESHOLD=100    # au-delà de N destinataires : double validation obligatoire
APPROVAL_LINK_TTL_HOURS=48           # durée de vie d'un lien de validation mobile
SMS_UNIT_COST_EUR=0.07               # pour l'estimation de coût
DAILY_BRIEFING_HOUR=7
SCHEDULER_ENABLED=true
